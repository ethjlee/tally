{
  "name": "tally-private-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "Private, single-owner Tally PWA with encrypted cloud sync.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node tests/client-regression.cjs",
    "check": "npm run audit:prod && npm run typecheck && npm test && npm run build && npm run smoke:production",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "smoke:production": "node tests/production-smoke.cjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "account:recover": "node --import tsx scripts/reset-owner-password.ts",
    "generate:secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.2.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
