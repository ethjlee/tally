# Neon injects DATABASE_URL automatically when connected through Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The public production origin, with no trailing slash.
BETTER_AUTH_URL=https://your-tally-domain.vercel.app

# Generate these with: npm run generate:secrets
BETTER_AUTH_SECRET=replace-with-generated-value
TALLY_SETUP_TOKEN=replace-with-generated-value
TALLY_DATA_ENCRYPTION_KEY=replace-with-generated-base64-key

# Keep this at "1" unless you intentionally rotate to a new encryption key.
TALLY_DATA_KEY_VERSION=1
